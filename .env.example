# ---- Database ----
# Postgres connection string (Neon, Supabase, Railway, or your own server)
DATABASE_URL="postgresql://user:password@host:5432/quran_madrasa?schema=public"

# ---- NextAuth (Admin Panel) ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string" # generate: openssl rand -base64 32

# ---- Site ----
NEXT_PUBLIC_SITE_URL="https://learnalquranonlinebd.com"
NEXT_PUBLIC_SITE_NAME="Learn Al Quran Online BD"

# ---- Google Analytics 4 ----
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"

# ---- Google Search Console (site verification meta tag content) ----
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ---- Contact / WhatsApp shown across site (fallback if DB SiteSetting empty) ----
NEXT_PUBLIC_WHATSAPP_NUMBER="8801234567890"
NEXT_PUBLIC_PHONE_NUMBER="+8801234567890"
